<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BenchApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bench"
        android:usesCleartextTraffic="true">

        <!--
          usesCleartextTraffic 이 release 매니페스트에도 있습니다.
          01 번에서는 src/debug 로 격리했는데 여기서는 그럴 수 없습니다.
          측정 대상인 웹 서버가 http://10.0.2.2:3000 이라 릴리스 빌드에서도 필요합니다.

          이건 이 실험의 편의를 위한 것이고 실제 앱에서는 하면 안 됩니다.
          실무 웹뷰는 https 를 쓰고, 그러면 이 설정이 필요 없습니다.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".web.WebViewActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name=".rn.RnActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize" />

    </application>
</manifest>
