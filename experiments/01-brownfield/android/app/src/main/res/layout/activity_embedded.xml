<?xml version="1.0" encoding="utf-8"?>
<!--
  네이티브가 위아래를 그리고, 가운데만 RN 이 채웁니다.
  ReactRootView 를 XML 에 직접 두지 않고 코드에서 붙이는 이유는
  startReactApplication 을 호출해야 뷰가 살아나기 때문입니다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111114"
        android:padding="16dp"
        android:text="@string/embedded_toolbar"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/rn_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!--
      네이티브 바. 여기 버튼을 누르면 바로 위 RN 영역이 반응합니다.
      네이티브와 RN 이 한 화면에 같이 떠 있어야 이벤트 전달을 눈으로 볼 수 있습니다.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F5F7"
        android:orientation="vertical"
        android:padding="12dp">

        <Button
            android:id="@+id/embedded_change_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/change_theme" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/embedded_footer"
            android:textColor="#6B6B74"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
