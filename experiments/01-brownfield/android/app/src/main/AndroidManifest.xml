<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".HostApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrownfieldHost">

        <!-- 앱의 진입점은 네이티브 화면입니다. RN 은 여기서 들어가는 하위 화면입니다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 전체 화면을 RN 이 차지하는 진입점 -->
        <activity
            android:name=".rn.RnHostActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- 네이티브 레이아웃 안에 RN 을 부분 삽입하는 진입점 -->
        <activity
            android:name=".rn.EmbeddedRnActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize" />

    </application>
</manifest>
