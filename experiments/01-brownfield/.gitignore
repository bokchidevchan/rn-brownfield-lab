# JS
node_modules/
.metro-health-check*
*.log

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/index.android.bundle
android/app/src/main/res/drawable-*/
android/app/src/main/res/raw/

# iOS
ios/Pods/
ios/build/
# pod install 이 만들어 내는 파일들
ios/PrivacyInfo.xcprivacy
ios/main.jsbundle
ios/.xcode.env.local
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/

# 서명 관련 파일은 저장소에 올리지 않습니다.
# 이 예제는 디버그 빌드만 다루고, 디버그 서명은 각자 로컬의
# ~/.android/debug.keystore 와 Xcode 자동 서명을 씁니다.
*.keystore
*.jks
*.p12
*.mobileprovision
*.cer
keystore.properties
.env
.env.*
