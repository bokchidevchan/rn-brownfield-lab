<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Metro 는 http 로 뜹니다. 그래서 디버그 빌드에만 평문 통신을 열어 줍니다.
      이 설정이 release 매니페스트로 새어 나가지 않게 반드시 src/debug 아래에 둡니다.
      기존 앱이 이미 networkSecurityConfig 를 쓰고 있다면 그 파일에
      localhost 예외를 추가하는 쪽이 맞습니다.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:targetApi="28" />
</manifest>
